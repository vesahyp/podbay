#!/usr/bin/env bash
# Moves the installed copy of podbay to origin/main, after its tests pass.
#
# The installed podbay runs from .release/, a git worktree of this repo
# checked out detached at a commit from origin/main. Edits in the working
# tree, uncommitted or on another branch, never reach it, so a session
# editing podbay cannot break the podbay that other sessions call.
#
# The path is derived from the git common dir, so `make install` from any
# worktree updates the same copy. If the tests fail at the new commit, the
# copy stays where it was and this exits non-zero. Tests run in a scratch
# worktree first, so a failing run never touches .release/.
set -euo pipefail

repo=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
release="$repo/.release"

git -C "$repo" fetch -q origin main
target=$(git -C "$repo" rev-parse origin/main)

# The running screen watches .release/ and restarts when it changes, so the
# tests run in a scratch worktree and .release/ moves only after they pass.
scratch=$(mktemp -d "${TMPDIR:-/tmp}/podbay-release.XXXXXX")
trap 'git -C "$repo" worktree remove --force "$scratch" 2>/dev/null || true; rm -rf "$scratch"' EXIT
git -C "$repo" worktree add -q --detach "$scratch" "$target"

if ! (cd "$scratch" && uv run --project . pytest -q); then
  echo "✗ tests failed at $(git -C "$scratch" rev-parse --short HEAD)" >&2
  if [ -e "$release/.git" ]; then
    echo "  installed copy stays at $(git -C "$release" rev-parse --short HEAD)" >&2
  fi
  exit 1
fi

if [ ! -e "$release/.git" ]; then
  git -C "$repo" worktree add -q --detach "$release" "$target"
else
  git -C "$release" checkout -q --detach "$target"
fi
echo "→ $release at $(git -C "$release" log --oneline -1)"
